{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/admin",  "destination": "/admin.html" },
    { "source": "/update", "destination": "/update.html" },
    { "source": "/demo",   "destination": "/demo.html" },
    { "source": "/info",   "destination": "/info.html" }
  ],
  "redirects": [
    { "source": "/typeaura.apk", "destination": "https://play.google.com/store/apps/details?id=com.typeaura.app", "permanent": true },
    { "source": "/download",     "destination": "https://play.google.com/store/apps/details?id=com.typeaura.app", "permanent": true }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
